{
  "name": "@yuni-kit/relative-time",
  "version": "0.1.0",
  "description": "A lightweight, zero-dependency relative time formatting utility for TypeScript.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuni-kit/relative-time.git"
  },
  "keywords": [],
  "author": "yuni-kit",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/yuni-kit/relative-time/issues"
  },
  "homepage": "https://github.com/yuni-kit/relative-time#readme",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}